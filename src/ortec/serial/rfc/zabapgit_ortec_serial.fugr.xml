<?xml version="1.0" encoding="utf-8"?>
<abapGit version="v1.0.0" serializer="LCL_OBJECT_FUGR" serializer_version="v1.0.0">
 <asx:abap xmlns:asx="http://www.sap.com/abapxml" version="1.0">
  <asx:values>
   <AREAT>ORTEC serialization batch RFC worker</AREAT>
   <INCLUDES>
    <SOBJ_NAME>LZABAPGIT_ORTEC_SERIALTOP</SOBJ_NAME>
    <SOBJ_NAME>SAPLZABAPGIT_ORTEC_SERIAL</SOBJ_NAME>
   </INCLUDES>
   <FUNCTIONS>
    <item>
     <FUNCNAME>Z_ABAPGIT_ORTEC_SER_BATCH</FUNCNAME>
     <REMOTE_CALL>R</REMOTE_CALL>
     <SHORT_TEXT>ORTEC: serialize a bounded batch of objects (aRFC worker)</SHORT_TEXT>
     <IMPORT>
      <RSIMP>
       <PARAMETER>IV_BATCH_ID</PARAMETER>
       <TYP>CHAR32</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_ATTEMPT</PARAMETER>
       <DEFAULT>1</DEFAULT>
       <OPTIONAL>X</OPTIONAL>
       <TYP>I</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_ABAP_LANGUAGE_VERS</PARAMETER>
       <TYP>UCCHECK</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_LANGUAGE</PARAMETER>
       <TYP>SY-LANGU</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_PATH</PARAMETER>
       <TYP>STRING</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_MAIN_LANGUAGE_ONLY</PARAMETER>
       <TYP>CHAR1</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_SUPPRESS_PO_COMMENTS</PARAMETER>
       <TYP>CHAR1</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_USE_LXE</PARAMETER>
       <TYP>CHAR1</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IT_TRANSLATION_LANGS</PARAMETER>
       <TYP>TFPLAISO</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IT_TADIR</PARAMETER>
       <TYP>ZAOG_SER_TADIR_TT</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_PREFETCH_BUFFER</PARAMETER>
       <OPTIONAL>X</OPTIONAL>
       <TYP>XSTRING</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_PREFETCH_BUFFER_EXT</PARAMETER>
       <OPTIONAL>X</OPTIONAL>
       <TYP>XSTRING</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_PREFETCH_BUFFER_OO</PARAMETER>
       <OPTIONAL>X</OPTIONAL>
       <TYP>XSTRING</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_PREFETCH_BUFFER_DD</PARAMETER>
       <OPTIONAL>X</OPTIONAL>
       <TYP>XSTRING</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_INPUT_ROW_COUNT</PARAMETER>
       <TYP>I</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_INPUT_VERSION</PARAMETER>
       <DEFAULT>1</DEFAULT>
       <OPTIONAL>X</OPTIONAL>
       <TYP>I</TYP>
      </RSIMP>
     </IMPORT>
     <EXPORT>
      <RSEXP>
       <PARAMETER>ET_RESULT</PARAMETER>
       <TYP>ZAOG_SER_BATCH_RESULT_TT</TYP>
      </RSEXP>
      <RSEXP>
       <PARAMETER>EV_OUTPUT_ROW_COUNT</PARAMETER>
       <TYP>I</TYP>
      </RSEXP>
     </EXPORT>
     <EXCEPTION>
      <RSEXC>
       <EXCEPTION>ERROR</EXCEPTION>
      </RSEXC>
     </EXCEPTION>
     <DOCUMENTATION>
      <RSFDO>
       <PARAMETER>IV_BATCH_ID</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Batch dispatch correlation ID (telemetry only)</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IV_ATTEMPT</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Dispatch attempt number (1 = first, then retries)</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IV_ABAP_LANGUAGE_VERS</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IV_LANGUAGE</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IV_PATH</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IV_MAIN_LANGUAGE_ONLY</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IV_SUPPRESS_PO_COMMENTS</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IV_USE_LXE</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IT_TRANSLATION_LANGS</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IT_TADIR</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Bounded batch of objects to serialize in this dispatch</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IV_PREFETCH_BUFFER</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IV_PREFETCH_BUFFER_EXT</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IV_PREFETCH_BUFFER_OO</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IV_PREFETCH_BUFFER_DD</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IV_INPUT_ROW_COUNT</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IV_INPUT_VERSION</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>ET_RESULT</PARAMETER>
       <KIND>P</KIND>
       <STEXT>One result row per object in IT_TADIR</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>EV_OUTPUT_ROW_COUNT</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Rows actually returned in ET_RESULT</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>ERROR</PARAMETER>
       <KIND>X</KIND>
      </RSFDO>
     </DOCUMENTATION>
    </item>
   </FUNCTIONS>
   <LONGTEXTS_Z_ABAPGIT_ORTEC_SER_BATCH>
    <item>
     <DOKIL>
      <ID>FU</ID>
      <OBJECT>Z_ABAPGIT_ORTEC_SER_BATCH</OBJECT>
      <LANGU>E</LANGU>
      <TYP>T</TYP>
      <VERSION>0001</VERSION>
      <MASTERLANG>X</MASTERLANG>
      <TXTLINES>00034</TXTLINES>
      <DOKSTATE>A</DOKSTATE>
     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>Z_ABAPGIT_ORTEC_SER_BATCH</TDNAME>
      <TDID>FU</TDID>
      <TDSPRAS>E</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00001</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U4</TDFORMAT>
       <TDLINE>&amp;FUNCTIONALITY&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Multi-object batch serialization worker for the ORTEC</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>adaptive serialization orchestrator (ZCL_ABAPGIT_ORTEC_SER_ORCH).</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Called only by ZCL_ABAPGIT_ORTEC_SER_ORCH via CALL FUNCTION</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>&apos;Z_ABAPGIT_ORTEC_SER_BATCH&apos; STARTING NEW TASK - not intended</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>for direct use by any other caller.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>One call processes a bounded batch (IT_TADIR), never the</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>whole repository - the caller/planner budgets rows/bytes</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>before dispatch. Every object produces exactly one</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>ET_RESULT row (success or failure).</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>This worker may serialize multiple different objects, one</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>after another, inside the SAME RFC work-process session</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>(unlike Z_ABAPGIT_SERIALIZE_PARALLEL, always exactly one).</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>WAPA may be processed here, but only as a singleton batch.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>It is never mixed with any other object in one dispatch.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U4</TDFORMAT>
       <TDLINE>&amp;EXAMPLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U4</TDFORMAT>
       <TDLINE>&amp;HINTS&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>IV_INPUT_VERSION and the ET_RESULT row shape are versioned</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>together - caller and worker built from different code</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>generations must not be mixed. IV_INPUT_ROW_COUNT and</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>EV_OUTPUT_ROW_COUNT let both sides cross-check batch size.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>No explicit COMMIT WORK/ROLLBACK WORK is issued here beyond</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>whatever the underlying per-object serialize() call already</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>does today.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>ERROR is reserved for a batch-level failure that prevents</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>this worker attempting any object at all (e.g. prefetch-</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>buffer injection failing) - an individual object&apos;s own</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>failure is always a normal ET_RESULT row with RC &lt;&gt; 0.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>No scheduling/cost statistics are persisted by this function</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>module - ELAPSED_MS/OUTPUT_BYTES are read back only by the</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>orchestrator&apos;s run-local, in-memory adaptive cost estimator.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U4</TDFORMAT>
       <TDLINE>&amp;FURTHER_SOURCES_OF_INF&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>.memory/logs/serialization_adaptive_batch_design.md</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>.memory/logs/serialization_slice_2_od14_audit.md</TDLINE>
      </TLINE>
     </LINES>
    </item>
   </LONGTEXTS_Z_ABAPGIT_ORTEC_SER_BATCH>
  </asx:values>
 </asx:abap>
</abapGit>
