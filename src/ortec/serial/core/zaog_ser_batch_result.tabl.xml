<?xml version="1.0" encoding="utf-8"?>
<abapGit version="v1.0.0" serializer="LCL_OBJECT_TABL" serializer_version="v1.0.0">
 <asx:abap xmlns:asx="http://www.sap.com/abapxml" version="1.0">
  <asx:values>
   <DD02V>
    <TABNAME>ZAOG_SER_BATCH_RESULT</TABNAME>
    <DDLANGUAGE>E</DDLANGUAGE>
    <TABCLASS>INTTAB</TABCLASS>
    <DDTEXT>ORTEC serialization batch worker: one object's result</DDTEXT>
    <MASTERLANG>E</MASTERLANG>
    <EXCLASS>1</EXCLASS>
   </DD02V>
   <DD03P_TABLE>
    <DD03P>
     <FIELDNAME>OBJ_TYPE</FIELDNAME>
     <ROLLNAME>TROBJTYPE</ROLLNAME>
     <ADMINFIELD>0</ADMINFIELD>
     <COMPTYPE>E</COMPTYPE>
     <DDTEXT>abapGit object type of the serialized item (matches TADIR-OBJECT, e.g. CLAS, INTF, DTEL, DOMA)</DDTEXT>
    </DD03P>
    <DD03P>
     <FIELDNAME>OBJ_NAME</FIELDNAME>
     <ROLLNAME>SOBJ_NAME</ROLLNAME>
     <ADMINFIELD>0</ADMINFIELD>
     <COMPTYPE>E</COMPTYPE>
     <DDTEXT>Name of the serialized item (matches TADIR-OBJ_NAME); together with OBJ_TYPE this is the object's canonical identity</DDTEXT>
    </DD03P>
    <DD03P>
     <FIELDNAME>RC</FIELDNAME>
     <ADMINFIELD>0</ADMINFIELD>
     <INTTYPE>X</INTTYPE>
     <INTLEN>000004</INTLEN>
     <DATATYPE>INT4</DATATYPE>
     <LENG>000010</LENG>
     <MASK>  INT4</MASK>
     <DDTEXT>Result code for this one object: 0 = serialized successfully, non-zero = failed (see MSGID/MSGNO/MSGVn)</DDTEXT>
    </DD03P>
    <DD03P>
     <FIELDNAME>FILES_XSTRING</FIELDNAME>
     <ADMINFIELD>0</ADMINFIELD>
     <INTTYPE>y</INTTYPE>
     <INTLEN>000008</INTLEN>
     <DATATYPE>RSTR</DATATYPE>
     <MASK>  RSTR</MASK>
     <DDTEXT>This object's serialized file list, EXPORTed to a data buffer in the same shape as the standard single-object result; initial when RC is not 0</DDTEXT>
    </DD03P>
    <DD03P>
     <FIELDNAME>MSGID</FIELDNAME>
     <ROLLNAME>SYMSGID</ROLLNAME>
     <ADMINFIELD>0</ADMINFIELD>
     <COMPTYPE>E</COMPTYPE>
     <DDTEXT>Message class of the failure; initial on success</DDTEXT>
    </DD03P>
    <DD03P>
     <FIELDNAME>MSGNO</FIELDNAME>
     <ROLLNAME>SYMSGNO</ROLLNAME>
     <ADMINFIELD>0</ADMINFIELD>
     <COMPTYPE>E</COMPTYPE>
     <DDTEXT>Message number of the failure; initial on success</DDTEXT>
    </DD03P>
    <DD03P>
     <FIELDNAME>MSGV1</FIELDNAME>
     <ROLLNAME>SYMSGV</ROLLNAME>
     <ADMINFIELD>0</ADMINFIELD>
     <COMPTYPE>E</COMPTYPE>
     <DDTEXT>Message variable 1 of the failure text; initial on success</DDTEXT>
    </DD03P>
    <DD03P>
     <FIELDNAME>MSGV2</FIELDNAME>
     <ROLLNAME>SYMSGV</ROLLNAME>
     <ADMINFIELD>0</ADMINFIELD>
     <COMPTYPE>E</COMPTYPE>
     <DDTEXT>Message variable 2 of the failure text; initial on success</DDTEXT>
    </DD03P>
    <DD03P>
     <FIELDNAME>MSGV3</FIELDNAME>
     <ROLLNAME>SYMSGV</ROLLNAME>
     <ADMINFIELD>0</ADMINFIELD>
     <COMPTYPE>E</COMPTYPE>
     <DDTEXT>Message variable 3 of the failure text; initial on success</DDTEXT>
    </DD03P>
    <DD03P>
     <FIELDNAME>MSGV4</FIELDNAME>
     <ROLLNAME>SYMSGV</ROLLNAME>
     <ADMINFIELD>0</ADMINFIELD>
     <COMPTYPE>E</COMPTYPE>
     <DDTEXT>Message variable 4 of the failure text; initial on success</DDTEXT>
    </DD03P>
    <DD03P>
     <FIELDNAME>ELAPSED_MS</FIELDNAME>
     <ADMINFIELD>0</ADMINFIELD>
     <INTTYPE>X</INTTYPE>
     <INTLEN>000004</INTLEN>
     <DATATYPE>INT4</DATATYPE>
     <LENG>000010</LENG>
     <MASK>  INT4</MASK>
     <DDTEXT>Wall-clock time spent serializing this one object, in milliseconds; input to the run-local adaptive cost estimator</DDTEXT>
    </DD03P>
    <DD03P>
     <FIELDNAME>OUTPUT_BYTES</FIELDNAME>
     <ADMINFIELD>0</ADMINFIELD>
     <INTTYPE>X</INTTYPE>
     <INTLEN>000004</INTLEN>
     <DATATYPE>INT4</DATATYPE>
     <LENG>000010</LENG>
     <MASK>  INT4</MASK>
     <DDTEXT>Size in bytes of this object's serialized output before compression; input to the run-local adaptive cost estimator</DDTEXT>
    </DD03P>
    <DD03P>
     <FIELDNAME>OUTPUT_FILE_COUNT</FIELDNAME>
     <ADMINFIELD>0</ADMINFIELD>
     <INTTYPE>X</INTTYPE>
     <INTLEN>000004</INTLEN>
     <DATATYPE>INT4</DATATYPE>
     <LENG>000010</LENG>
     <MASK>  INT4</MASK>
     <DDTEXT>Number of files produced for this object</DDTEXT>
    </DD03P>
    <DD03P>
     <FIELDNAME>PROVIDER_HIT</FIELDNAME>
     <ADMINFIELD>0</ADMINFIELD>
     <INTTYPE>X</INTTYPE>
     <INTLEN>000004</INTLEN>
     <DATATYPE>INT4</DATATYPE>
     <LENG>000010</LENG>
     <MASK>  INT4</MASK>
     <DDTEXT>1 if a batch-scoped prefetch provider supplied this object's data, 0 if the standard per-object read was used</DDTEXT>
    </DD03P>
    <DD03P>
     <FIELDNAME>PROVIDER_MISS</FIELDNAME>
     <ADMINFIELD>0</ADMINFIELD>
     <INTTYPE>X</INTTYPE>
     <INTLEN>000004</INTLEN>
     <DATATYPE>INT4</DATATYPE>
     <LENG>000010</LENG>
     <MASK>  INT4</MASK>
     <DDTEXT>1 if a provider claimed support for this object's type but had no prefetched data for it, 0 otherwise</DDTEXT>
    </DD03P>
    <DD03P>
     <FIELDNAME>PROVIDER_FALLBACK</FIELDNAME>
     <ADMINFIELD>0</ADMINFIELD>
     <INTTYPE>X</INTTYPE>
     <INTLEN>000004</INTLEN>
     <DATATYPE>INT4</DATATYPE>
     <LENG>000010</LENG>
     <MASK>  INT4</MASK>
     <DDTEXT>1 if no batch-scoped provider was consulted for this object at all (generic/no-prefetch path), 0 otherwise</DDTEXT>
    </DD03P>
   </DD03P_TABLE>
  </asx:values>
 </asx:abap>
</abapGit>
