%% Variant B - Slice 1: durable materialization state machine
%% hist_level x snap_state combined states. API calls own the transitions.
%% (GRAPH_COMPLETE|FULL_COMPLETE, INVALID) is not reachable: invalidate_commit
%% always resets hist_level to UNKNOWN in the same call.
stateDiagram-v2
    [*] --> U_N

    state "hist=UNKNOWN / snap=NONE" as U_N
    state "hist=UNKNOWN / snap=PENDING" as U_P
    state "hist=UNKNOWN / snap=INVALID" as U_I
    state "hist=GRAPH_COMPLETE / snap=PENDING" as G_P
    state "hist=GRAPH_COMPLETE / snap=COMPLETE" as G_C
    state "hist=FULL_COMPLETE / snap=PENDING" as F_P
    state "hist=FULL_COMPLETE / snap=COMPLETE" as F_C
    state "REJECTED (raises zcx_abapgit_ortec_git, no state change)" as REJ

    U_N --> U_P : begin_attempt()
    U_I --> U_P : begin_attempt()

    U_P --> G_P : mark_graph_complete()\n[attempt_id matches]
    G_P --> G_C : publish_snapshot_complete()\n[branch fetch_commit + snap_state\nupdated atomically, no COMMIT WORK]
    G_P --> G_P : begin_attempt()\n[refresh attempt_id only]
    G_C --> G_C : begin_attempt()\n[refresh attempt_id,\nsnap_state left COMPLETE]

    G_P --> F_P : mark_full_complete()\n[attempt_id matches]
    G_C --> F_C : mark_full_complete()\n[attempt_id matches,\nsnap_state left COMPLETE]
    F_P --> F_C : publish_snapshot_complete()
    F_P --> F_P : begin_attempt()\n[refresh attempt_id only]
    F_C --> F_C : begin_attempt()\n[refresh attempt_id,\nsnap_state left COMPLETE]

    U_N --> U_I : invalidate_commit()
    U_P --> U_I : invalidate_commit()
    G_P --> U_I : invalidate_commit()
    G_C --> U_I : invalidate_commit()
    F_P --> U_I : invalidate_commit()
    F_C --> U_I : invalidate_commit()

    U_N --> REJ : publish_snapshot_complete()\n[hist < GRAPH_COMPLETE]
    U_P --> REJ : publish_snapshot_complete()\n[hist < GRAPH_COMPLETE]
    U_I --> REJ : publish_snapshot_complete()\n[hist < GRAPH_COMPLETE]
    U_N --> REJ : mark_full_complete()\n[hist < GRAPH_COMPLETE]
    U_P --> REJ : mark_full_complete()\n[hist < GRAPH_COMPLETE]
    U_I --> REJ : mark_full_complete()\n[hist < GRAPH_COMPLETE]
    U_N --> REJ : mark_graph_complete()\n[stale/absent attempt_id]

    note right of U_I
      snap_state INVALID only ever
      coexists with hist_level UNKNOWN.
      A snapshot-only retry (graph still
      good, snapshot batch failed) stays
      at G_P/F_P - no separate
      mark_snapshot_invalid exists.
    end note

    note right of REJ
      clean_incomplete_attempts() is a
      set-based, out-of-band sweep of
      orphaned attempt_id values; it does
      not appear as a modeled transition
      here since it never changes
      hist_level/snap_state.
    end note
