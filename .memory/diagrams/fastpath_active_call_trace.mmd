  FP_UPB2 --> UP2["zcl_abapgit_ortec_fastpath=>upload_pack"]
  UP2 -->|"CATCH both exception types again"| RAISE["raise zcx_abapgit_ortec_git\n(combines both failure texts)"]
  RAISE --> TRANSPORT

  subgraph UPLOAD_PACK["Inside EACH upload_pack() attempt (L590-779) - identical logic for thin AND non-thin"]
    direction TB
    U1["HTTP send/receive pack bytes (io_client)\n-- low-level transport, OK per assumption (a)"]
    U2{"is_active_for_repo(url)\nAND repo_key resolvable?"}
    U3["zcl_abapgit_ortec_pack_dec=>decode_and_persist\n(ORTEC: kernel stream_decompress,\nOFS/REF delta resolve, ZAOG_* persist)"]
    U4{"TRY around U3:\nreturned objects non-initial?"}
    U5["RETURN - Ortec path complete"]
    U6["CATCH zcx_abapgit_exception\n*** SILENTLY SWALLOWED, NO LOG ***"]
    U7["FALLTHROUGH (unconditional, no guard):\nset_active_repo_key(...)\nrt_objects = zcl_abapgit_git_pack=>decode(lv_pack)\n*** STANDARD DECODER, SAME PACK BYTES ***"]
    U1 --> U2
    U2 -->|"yes"| U3
    U2 -->|"no (switch off / blank repo key)"| U7
    U3 --> U4
    U4 -->|"yes"| U5
    U4 -->|"no / raised"| U6
    U6 --> U7
  end

  UP1 -.-> UPLOAD_PACK
  UP2 -.-> UPLOAD_PACK
  U7 -->|"decode succeeds (pack was self-contained)\n-> returns normally, NO exception,\nfastpath tier reports 'success'"| U5b["objects returned to caller\n(silently used standard slow decode)"]
  U7 -->|"decode fails (e.g. ofs-delta byte pattern\nstandard decoder can't parse:\n'Todo, unknown git pack type')\n-> raises zcx_abapgit_exception"| UP1CATCH["propagates out of upload_pack()\n-> caught by upload_pack_by_branch/commit\n-> triggers non-thin retry / final raise"]

